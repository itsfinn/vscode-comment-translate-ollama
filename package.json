{
  "name": "ollama-comment-translate",
  "displayName": "ollama-comment-translate",
  "description": "ollama translate source for comment-translate",
  "version": "1.0.0",
  "publisher": "itsfinn",
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "translateSource",
    "comment translate",
    "ollama",
    "ollama translate",
    "翻译",
    "注释"
  ],
  "homepage": "https://github.com/itsfinn/vscode-comment-translate-ollama#readme",
  "bugs": {
    "url": "https://github.com/itsfinn/vscode-comment-translate-ollama/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsfinn/vscode-comment-translate-ollama.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "icon": "image/logo.png",
  "extensionDependencies": [
    "intellsmi.comment-translate"
  ],
  "contributes": {
    "translates": [
      {
        "translate": "ollama",
        "title": "Ollama translate"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.4",
    "@types/mocha": "^9.0.0",
    "@types/node": "14.x",
    "@types/vscode": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.1.0",
    "@vscode/test-electron": "^1.6.2",
    "eslint": "^8.1.0",
    "glob": "^7.1.7",
    "mocha": "^9.1.3",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "axios": "0.21.4",
    "comment-translate-manager": "^0.0.2",
    "querystring": "^0.2.1"
  }
}
